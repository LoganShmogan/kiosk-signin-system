# Copy this file to .env and fill in a real value (never commit .env itself).
# python-dotenv loads this automatically if it's installed and present.

# Long random string used to sign dashboard session cookies. If unset, a
# random key is generated each time the app starts, which logs everyone out
# on every restart. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=

# Leave unset/false (default) — the dashboard is reachable both over plain
# HTTP on the local network and over HTTPS via a reverse tunnel, and a
# Secure-flagged cookie breaks LAN logins. Only set to "true" if this is ever
# deployed somewhere reachable exclusively over HTTPS.
DASHBOARD_COOKIE_SECURE=false
